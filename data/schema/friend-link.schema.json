{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/friend-link.schema.json",
  "title": "FriendLink",
  "type": "object",
  "required": ["name", "url", "description", "source", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "avatar": {
      "type": "string",
      "format": "uri"
    },
    "description": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120
    },
    "rss": {
      "type": "string",
      "format": "uri"
    },
    "source": {
      "type": "string",
      "enum": ["manual", "submitted"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
